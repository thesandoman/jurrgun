{
  "name": "sv-cloud-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "start": "wrangler dev",
    "test": "vitest run",
    "check": "node scripts/check.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/assets-manifest.mjs",
    "assets:check": "node scripts/assets-manifest.mjs --check",
    "assets:local": "node scripts/assets-manifest.mjs --seed-local",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "migrations": "node scripts/build-migrations.mjs",
    "seed": "vite-node scripts/seed.ts",
    "svmap": "node scripts/build-svmap.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "postgres": "^3.4.9",
    "qrcode-generator": "^1.4.4",
    "sv-map": "https://codeload.github.com/thesandoman/sv-map/tar.gz/9fac25925dff817c0d221ba98cdb02b283b83438"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.105.0"
  }
}
